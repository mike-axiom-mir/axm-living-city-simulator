{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.living-city-sim.world/v0.5.0",
  "title": "AXM Living City Sim World v0.5.0",
  "description": "Deterministic Living City world with structural habitats, consent-bound stewardship, separate family continuity, autonomous dependents, care evidence, and life-course transitions.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "seed",
    "rngState",
    "idCounter",
    "time",
    "map",
    "settings",
    "player",
    "people",
    "places",
    "households",
    "householdProposals",
    "householdIssues",
    "habitatIntentions",
    "stewardshipRequests",
    "familyUnits",
    "familyProposals",
    "careRecords",
    "ledger",
    "tutorial",
    "metrics",
    "activeShift",
    "ui",
    "flags"
  ],
  "properties": {
    "schema": {
      "const": "axm.living-city-sim.world/v0.5.0"
    },
    "version": {
      "const": "0.5.0"
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "rngState": {
      "type": "integer",
      "minimum": 0
    },
    "idCounter": {
      "type": "integer",
      "minimum": 0
    },
    "time": {
      "type": "object",
      "required": [
        "day",
        "hour"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        }
      },
      "additionalProperties": true
    },
    "map": {
      "type": "object"
    },
    "settings": {
      "type": "object"
    },
    "player": {
      "type": "object",
      "required": [
        "id",
        "name",
        "homePropertyId",
        "householdId",
        "money",
        "relationships",
        "storedFurniture",
        "familyUnitId",
        "lifeCourse"
      ],
      "properties": {
        "id": {
          "const": "player"
        },
        "name": {
          "type": "string"
        },
        "homePropertyId": {
          "type": "string"
        },
        "householdId": {
          "type": [
            "string",
            "null"
          ]
        },
        "money": {
          "type": "number"
        },
        "relationships": {
          "type": "object"
        },
        "storedFurniture": {
          "type": "array"
        },
        "familyUnitId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifeCourse": {
          "$ref": "#/$defs/lifeCourse"
        },
        "dependent": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "homePropertyId",
          "householdId",
          "money",
          "relationships",
          "storedFurniture",
          "familyUnitId",
          "lifeCourse"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "homePropertyId": {
            "type": "string"
          },
          "householdId": {
            "type": [
              "string",
              "null"
            ]
          },
          "money": {
            "type": "number"
          },
          "relationships": {
            "type": "object"
          },
          "storedFurniture": {
            "type": "array"
          },
          "householdInitiativeCooldownUntil": {
            "type": "integer"
          },
          "habitatIntentionCooldownUntil": {
            "type": "integer",
            "minimum": 0
          },
          "stewardshipReliability": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "familyUnitId": {
            "type": [
              "string",
              "null"
            ]
          },
          "lifeCourse": {
            "$ref": "#/$defs/lifeCourse"
          },
          "dependent": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tenants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "furniture": {
            "type": "array"
          },
          "rentBasis": {
            "enum": [
              "per_tenant",
              "whole_property"
            ]
          },
          "utilitiesIncluded": {
            "type": "boolean"
          },
          "weeklyUtilityBase": {
            "type": "number",
            "minimum": 0
          },
          "habitat": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "schema",
                  "revision",
                  "rooms",
                  "partitions",
                  "projects",
                  "layoutHash"
                ],
                "properties": {
                  "schema": {
                    "const": "axm.structural-habitat/v0.4.0"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rooms": {
                    "type": "array",
                    "minItems": 1
                  },
                  "partitions": {
                    "type": "array"
                  },
                  "projects": {
                    "type": "array"
                  },
                  "layoutHash": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "stewardship": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "schema",
                  "policy",
                  "requestIds",
                  "completedIntentionIds",
                  "history"
                ],
                "properties": {
                  "schema": {
                    "const": "axm.property-stewardship/v0.4.0"
                  },
                  "policy": {
                    "type": "object"
                  },
                  "requestIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "completedIntentionIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "history": {
                    "type": "array"
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "residential"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "tenants",
                "furniture",
                "habitat",
                "stewardship"
              ]
            }
          }
        ]
      }
    },
    "households": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/household"
      }
    },
    "householdProposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "householdIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historyEvent"
      }
    },
    "tutorial": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "activeShift": {
      "type": [
        "object",
        "null"
      ]
    },
    "ui": {
      "type": "object"
    },
    "flags": {
      "type": "object"
    },
    "habitatIntentions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "schema",
          "residentId",
          "propertyId",
          "status",
          "kind",
          "funding",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "schema": {
            "const": "axm.habitat-intention/v0.4.0"
          },
          "residentId": {
            "type": "string"
          },
          "propertyId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "saving",
              "awaiting_permission",
              "approved_saving",
              "ready",
              "working",
              "completed",
              "declined",
              "withdrawn",
              "failed"
            ]
          },
          "kind": {
            "enum": [
              "surface",
              "repair",
              "utility",
              "partition"
            ]
          },
          "funding": {
            "type": "object"
          },
          "history": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "stewardshipRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "schema",
          "intentionId",
          "residentId",
          "propertyId",
          "status",
          "authorities",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "schema": {
            "const": "axm.stewardship-request/v0.4.0"
          },
          "intentionId": {
            "type": "string"
          },
          "residentId": {
            "type": "string"
          },
          "propertyId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending_player",
              "pending_external",
              "approved",
              "declined",
              "withdrawn",
              "completed",
              "expired"
            ]
          },
          "authorities": {
            "type": "object"
          },
          "history": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "familyUnits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "schema",
          "status",
          "members",
          "carePlan",
          "roomAssignments",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "schema": {
            "const": "axm.living-city.family-unit/v0.5.0"
          },
          "status": {
            "enum": [
              "active",
              "continuing_separately",
              "ended"
            ]
          },
          "members": {
            "type": "array",
            "minItems": 2
          },
          "carePlan": {
            "type": "object"
          },
          "roomAssignments": {
            "type": "array"
          },
          "history": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "familyProposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "schema",
          "type",
          "status",
          "proposerId",
          "recipientIds",
          "terms",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "schema": {
            "const": "axm.living-city.family-proposal/v0.5.0"
          },
          "type": {
            "enum": [
              "parenthood",
              "care_plan",
              "education_plan",
              "room_plan",
              "family_ritual"
            ]
          },
          "status": {
            "enum": [
              "pending_npc",
              "awaiting_player",
              "accepted",
              "declined",
              "withdrawn",
              "expired",
              "waiting_space",
              "implemented"
            ]
          },
          "proposerId": {
            "type": "string"
          },
          "recipientIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terms": {
            "type": "object"
          },
          "history": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "careRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "schema",
          "familyUnitId",
          "personId",
          "day",
          "requiredHours",
          "playerHours",
          "partnerHours",
          "communityHours",
          "cost",
          "actions",
          "needsMet",
          "environmentSupport",
          "strainAdded",
          "finalized"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "schema": {
            "const": "axm.living-city.care-record/v0.5.0"
          },
          "familyUnitId": {
            "type": "string"
          },
          "personId": {
            "type": "string"
          },
          "day": {
            "type": "integer",
            "minimum": 1
          },
          "requiredHours": {
            "type": "number",
            "minimum": 0
          },
          "playerHours": {
            "type": "number",
            "minimum": 0
          },
          "partnerHours": {
            "type": "number",
            "minimum": 0
          },
          "communityHours": {
            "type": "number",
            "minimum": 0
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "actions": {
            "type": "array"
          },
          "needsMet": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "environmentSupport": {
            "type": "number",
            "minimum": 0
          },
          "strainAdded": {
            "type": "number",
            "minimum": 0
          },
          "finalized": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "historyEvent": {
      "type": "object",
      "required": [
        "id",
        "day",
        "hour",
        "type",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "day": {
          "type": "integer",
          "minimum": 1
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "actorIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "issueId": {
          "type": [
            "string",
            "null"
          ]
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {}
      },
      "additionalProperties": true
    },
    "zone": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "label",
        "holderIds",
        "rect"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "player_private",
            "common",
            "partner_private"
          ]
        },
        "label": {
          "type": "string"
        },
        "holderIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rect": {
          "type": "object",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "w": {
              "type": "integer",
              "minimum": 1
            },
            "h": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agreement": {
      "type": "object",
      "required": [
        "commitment",
        "finances",
        "space",
        "relocation",
        "renovation",
        "goals",
        "dissolution"
      ],
      "properties": {
        "commitment": {
          "const": "partner"
        },
        "finances": {
          "type": "object",
          "required": [
            "mode",
            "shares",
            "weeklyReserveTarget",
            "personalAccountsRemainSeparate",
            "sharedReserveRequiresMutualConsent"
          ],
          "properties": {
            "mode": {
              "enum": [
                "equal",
                "income_weighted",
                "player_covers_more",
                "partner_covers_more",
                "separate"
              ]
            },
            "shares": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "weeklyReserveTarget": {
              "type": "number",
              "minimum": 0,
              "maximum": 120
            },
            "personalAccountsRemainSeparate": {
              "const": true
            },
            "sharedReserveRequiresMutualConsent": {
              "const": true
            }
          },
          "additionalProperties": true
        },
        "space": {
          "type": "object",
          "required": [
            "mode",
            "editPolicy",
            "zones"
          ],
          "properties": {
            "mode": {
              "enum": [
                "mostly_shared",
                "private_edges_shared_center",
                "strong_private"
              ]
            },
            "editPolicy": {
              "const": "owner_or_accepted_proposal"
            },
            "zones": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/zone"
              }
            }
          },
          "additionalProperties": true
        },
        "relocation": {
          "type": "object",
          "required": [
            "requiresUnanimousConsent",
            "noUnilateralDisplacement"
          ],
          "properties": {
            "requiresUnanimousConsent": {
              "const": true
            },
            "noUnilateralDisplacement": {
              "const": true
            }
          },
          "additionalProperties": true
        },
        "renovation": {
          "type": "object",
          "required": [
            "partnerObjectsRequireOwnerConsent",
            "commonChangesRequireAcceptedProposal"
          ],
          "properties": {
            "partnerObjectsRequireOwnerConsent": {
              "const": true
            },
            "commonChangesRequireAcceptedProposal": {
              "const": true
            }
          },
          "additionalProperties": true
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "target",
              "progress",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "shared_safety_fund",
                  "improve_home",
                  "move_to_better_home",
                  "protect_free_time"
                ]
              },
              "target": {
                "type": "number",
                "minimum": 0
              },
              "progress": {
                "type": "number",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "active",
                  "complete",
                  "replaced"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "dissolution": {
          "type": "object",
          "required": [
            "exitIsUnilateral",
            "noForcedEviction",
            "reserveRule"
          ],
          "properties": {
            "exitIsUnilateral": {
              "const": true
            },
            "noForcedEviction": {
              "const": true
            },
            "reserveRule": {
              "const": "recorded_contributions_or_equal"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "household": {
      "type": "object",
      "required": [
        "id",
        "memberIds",
        "status",
        "homePropertyId",
        "createdDay",
        "createdHour",
        "revision",
        "agreement",
        "sharedReserve",
        "strain",
        "unresolvedIssueIds",
        "history"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "memberIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "active",
            "ended"
          ]
        },
        "homePropertyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdDay": {
          "type": "integer",
          "minimum": 1
        },
        "createdHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "agreement": {
          "$ref": "#/$defs/agreement"
        },
        "sharedReserve": {
          "type": "number",
          "minimum": 0
        },
        "strain": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "unresolvedIssueIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "lastConflictDay": {
          "type": "integer"
        },
        "lastReviewDay": {
          "type": "integer"
        },
        "nextNpcInitiativeDay": {
          "type": "integer"
        },
        "lastReserveWeek": {
          "type": "integer"
        },
        "completedRelocations": {
          "type": "integer",
          "minimum": 0
        },
        "endedDay": {
          "type": "integer"
        },
        "endedHour": {
          "type": "integer"
        },
        "endMode": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historyEvent"
          }
        }
      },
      "additionalProperties": true
    },
    "proposal": {
      "type": "object",
      "required": [
        "id",
        "householdId",
        "type",
        "proposerId",
        "recipientIds",
        "status",
        "terms",
        "createdDay",
        "createdHour",
        "dueDay",
        "expiresDay",
        "history"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "householdId": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "commitment",
            "cohabitation",
            "finance",
            "space",
            "relocation",
            "goal",
            "renovation"
          ]
        },
        "proposerId": {
          "type": "string"
        },
        "recipientIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "pending_npc",
            "awaiting_player",
            "accepted",
            "implemented",
            "countered",
            "declined",
            "withdrawn",
            "expired",
