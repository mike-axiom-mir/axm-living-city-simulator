{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.living-city.building-shell/v0.10.0",
  "title": "AXM Living City Building Shell v0.10.0",
  "description": "Persistent low-graphic building shell connecting existing places to storeys, exterior wall graphs, openings, internal routes, roof identity, and current interiors without fabricating past construction.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "type",
    "placeIds",
    "footprint",
    "frontSide",
    "storeys",
    "verticalLinks",
    "routeNetwork",
    "externalAccessNodeIds",
    "frontages",
    "roof",
    "interiorContinuity",
    "revision",
    "history"
  ],
  "properties": {
    "schema": {
      "const": "axm.living-city.building-shell/v0.10.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "placeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "footprint": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "frontSide": {
      "enum": [
        "north",
        "east",
        "south",
        "west"
      ]
    },
    "storeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "label",
          "heightMeters",
          "placeIds",
          "wallGraph",
          "openings"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string"
          },
          "heightMeters": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "placeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wallGraph": {
            "type": "object",
            "required": [
              "nodes",
              "edges"
            ],
            "properties": {
              "nodes": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "edges": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "from",
                    "to",
                    "side",
                    "kind",
                    "openingIds"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "side": {
                      "enum": [
                        "north",
                        "east",
                        "south",
                        "west"
                      ]
                    },
                    "kind": {
                      "const": "exterior_wall"
                    },
                    "openingIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": false
          },
          "openings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "wallEdgeId"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "window",
                    "external_door"
                  ]
                },
                "wallEdgeId": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "verticalLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "fromNodeId",
          "toNodeId",
          "fromLevel",
          "toLevel"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "const": "stairs"
          },
          "fromNodeId": {
            "type": "string"
          },
          "toNodeId": {
            "type": "string"
          },
          "fromLevel": {
            "type": "integer"
          },
          "toLevel": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "routeNetwork": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "level"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "level": {
                "type": "integer"
              }
            },
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "from",
              "to",
              "kind",
              "minutes"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "entry_passage",
                  "stairs",
                  "unit_entry"
                ]
              },
              "minutes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "externalAccessNodeIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "frontages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "placeId",
          "doorColor",
          "frameStyle",
          "windowBoxes",
          "entryLight",
          "signText",
          "accentColor",
          "authoredBy",
          "revision",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "placeId": {
            "type": "string"
          },
          "doorColor": {
            "type": "string"
          },
          "frameStyle": {
            "type": "string"
          },
          "windowBoxes": {
            "type": "boolean"
          },
          "entryLight": {
            "type": "string"
          },
          "signText": {
            "type": "string"
          },
          "accentColor": {
            "type": "string"
          },
          "authoredBy": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "day",
                "hour",
                "minute",
                "type",
                "message"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "day": {
                  "type": "integer"
                },
                "hour": {
                  "type": "integer"
                },
                "minute": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    },
    "roof": {
      "type": "object",
      "required": [
        "style",
        "material",
        "condition",
        "maintenanceObligation",
        "source"
      ],
      "properties": {
        "style": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "condition": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maintenanceObligation": {
          "const": false
        },
        "source": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "interiorContinuity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "placeId",
          "primaryStoreyId",
          "unitRouteNodeId",
          "streetAccessNodeId",
          "status",
          "source"
        ],
        "properties": {
          "placeId": {
            "type": "string"
          },
          "primaryStoreyId": {
            "type": "string"
          },
          "unitRouteNodeId": {
            "type": "string"
          },
          "streetAccessNodeId": {
            "type": "string"
          },
          "exteriorDoorNodeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "habitatEntryRoomId": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "const": "connected"
          },
          "source": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "day",
          "hour",
          "minute",
          "type",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "day": {
            "type": "integer"
          },
          "hour": {
            "type": "integer"
          },
          "minute": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
