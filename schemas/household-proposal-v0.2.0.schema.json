{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.living-city-sim.household-proposal/v0.2.0",
  "title": "AXM Household Proposal v0.2.0",
  "description": "Portable proposal record. A proposal is evidence of a request, not evidence of consent. Only implemented status may change agreement state.",
  "$ref": "#/$defs/proposal",
  "$defs": {
    "historyEvent": {
      "type": "object",
      "required": [
        "id",
        "day",
        "hour",
        "type",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "day": {
          "type": "integer",
          "minimum": 1
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "actorIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "issueId": {
          "type": [
            "string",
            "null"
          ]
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {}
      },
      "additionalProperties": true
    },
    "proposal": {
      "type": "object",
      "required": [
        "id",
        "householdId",
        "type",
        "proposerId",
        "recipientIds",
        "status",
        "terms",
        "createdDay",
        "createdHour",
        "dueDay",
        "expiresDay",
        "history"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "householdId": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "commitment",
            "cohabitation",
            "finance",
            "space",
            "relocation",
            "goal",
            "renovation"
          ]
        },
        "proposerId": {
          "type": "string"
        },
        "recipientIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "pending_npc",
            "awaiting_player",
            "accepted",
            "implemented",
            "countered",
            "declined",
            "withdrawn",
            "expired",
            "failed"
          ]
        },
        "terms": {
          "type": "object"
        },
        "parentProposalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdDay": {
          "type": "integer",
          "minimum": 1
        },
        "createdHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "dueDay": {
          "type": "integer",
          "minimum": 1
        },
        "expiresDay": {
          "type": "integer",
          "minimum": 1
        },
        "response": {
          "type": [
            "object",
            "null"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historyEvent"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
