{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.structural-habitat/v0.4.0",
  "title": "AXM Structural Habitat v0.4.0",
  "description": "Deterministic room, partition, surface, utility, project, history, and layout-evidence record supporting resident-authored stewardship.",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "nextRoomCounter",
    "entrance",
    "structuralCondition",
    "partitions",
    "rooms",
    "roomConnections",
    "utilities",
    "projects",
    "layoutHash",
    "migratedFromZones",
    "history"
  ],
  "properties": {
    "schema": {
      "const": "axm.structural-habitat/v0.4.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "nextRoomCounter": {
      "type": "integer",
      "minimum": 0
    },
    "entrance": {
      "type": "object",
      "required": [
        "x",
        "y",
        "side",
        "kind"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "side": {
          "enum": [
            "north",
            "south",
            "east",
            "west"
          ]
        },
        "kind": {
          "const": "exterior_door"
        }
      },
      "additionalProperties": false
    },
    "structuralCondition": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "key",
          "kind",
          "materialId",
          "condition",
          "loadBearing",
          "createdDay",
          "door",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "pattern": "^[VH]:[0-9]+:[0-9]+$"
          },
          "kind": {
            "enum": [
              "wall",
              "door"
            ]
          },
          "materialId": {
            "enum": [
              "reclaimed_timber",
              "timber_frame",
              "light_metal",
              "masonry"
            ]
          },
          "condition": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "loadBearing": {
            "type": "boolean"
          },
          "createdDay": {
            "type": "number",
            "minimum": 0
          },
          "door": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "styleId",
                  "open",
                  "lockPolicy",
                  "condition"
                ],
                "properties": {
                  "styleId": {
                    "type": "string"
                  },
                  "open": {
                    "type": "boolean"
                  },
                  "lockPolicy": {
                    "type": "string"
                  },
                  "condition": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "history": {
            "type": "array"
          }
        },
        "additionalProperties": false
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "purposeSource",
          "cells",
          "anchor",
          "bounds",
          "area",
          "centroid",
          "finish",
          "utilityAccess",
          "permissionSnapshot",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "enum": [
              "flexible",
              "entry",
              "living",
              "sleep",
              "work",
              "kitchen",
              "bathroom",
              "storage",
              "hobby",
              "workshop"
            ]
          },
          "purposeSource": {
            "enum": [
              "unassigned",
              "inferred",
              "player",
              "agreement",
              "migration",
              "resident",
              "stewardship"
            ]
          },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9]+,[0-9]+$"
            },
            "uniqueItems": true
          },
          "anchor": {
            "$ref": "#/$defs/point"
          },
          "bounds": {
            "type": "object",
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "w": {
                "type": "integer",
                "minimum": 1
              },
              "h": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "area": {
            "type": "integer",
            "minimum": 1
          },
          "centroid": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "finish": {
            "type": "object",
            "required": [
              "floorFinishId",
              "wallFinishId",
              "condition"
            ],
            "properties": {
              "floorFinishId": {
                "type": "string"
              },
              "wallFinishId": {
                "type": "string"
              },
              "condition": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": false
          },
          "utilityAccess": {
            "$ref": "#/$defs/utilityAccess"
          },
          "permissionSnapshot": {
            "type": "object"
          },
          "history": {
            "type": "array"
          },
          "familyPermissionSnapshot": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "roomConnections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "edgeKey",
          "kind",
          "roomIds",
          "passable",
          "lockPolicy"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "edgeKey": {
            "type": "string"
          },
          "kind": {
            "const": "door"
          },
          "roomIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true
          },
          "passable": {
            "type": "boolean"
          },
          "lockPolicy": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "utilities": {
      "type": "object",
      "required": [
        "serviceEntry",
        "services",
        "history"
      ],
      "properties": {
        "serviceEntry": {
          "$ref": "#/$defs/point"
        },
        "services": {
          "type": "object",
          "required": [
            "power",
            "water",
            "waste"
          ],
          "properties": {
            "power": {
              "$ref": "#/$defs/service"
            },
            "water": {
              "$ref": "#/$defs/service"
            },
            "waste": {
              "$ref": "#/$defs/service"
            }
          },
          "additionalProperties": false
        },
        "history": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "id",
          "status"
        ],
        "properties": {
          "schema": {
            "const": "axm.construction-project/v0.4.0"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "active",
              "completed",
              "cancelled",
              "failed"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "layoutHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "migratedFromZones": {
      "type": "boolean"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historyEvent"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "utilityAccess": {
      "type": "object",
      "required": [
        "power",
        "water",
        "waste"
      ],
      "properties": {
        "power": {
          "type": "boolean"
        },
        "water": {
          "type": "boolean"
        },
        "waste": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "level",
        "condition",
        "capacity"
      ],
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0
        },
        "condition": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "capacity": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "historyEvent": {
      "type": "object",
      "required": [
        "day",
        "hour",
        "type",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "day": {
          "type": "integer",
          "minimum": 1
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "actorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "actorIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {}
      },
      "additionalProperties": true
    }
  }
}
