{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.living-city.street-network/v0.9.0",
  "title": "AXM Living City Street Network v0.9.0",
  "description": "Deterministically derived pedestrian graph linking place entrances. The graph supports visible and compressed routes with equal duration and cost.",
  "type": "object",
  "required": [
    "schema",
    "generatedFrom",
    "lanes",
    "connectors",
    "nodes",
    "edges",
    "adjacency"
  ],
  "properties": {
    "schema": {
      "const": "axm.living-city.street-network/v0.9.0"
    },
    "generatedFrom": {
      "type": "object",
      "required": [
        "seed",
        "mapWidth",
        "mapHeight"
      ],
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "mapWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mapHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "y",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "y": {
            "type": "number"
          },
          "color": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "x"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "streetId",
          "streetName",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "street",
              "door"
            ]
          },
          "placeId": {
            "type": "string",
            "minLength": 1
          },
          "streetId": {
            "type": "string",
            "minLength": 1
          },
          "streetName": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "streetId",
          "streetName",
          "distanceMeters",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "street",
              "passage",
              "frontage"
            ]
          },
          "streetId": {
            "type": "string",
            "minLength": 1
          },
          "streetName": {
            "type": "string",
            "minLength": 1
          },
          "distanceMeters": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "adjacency": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "edgeId",
            "nodeId",
            "weight"
          ],
          "properties": {
            "edgeId": {
              "type": "string",
              "minLength": 1
            },
            "nodeId": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
